<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.fmangoni</groupId>
    <artifactId>forge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>forge-app</artifactId>
  <description>The editor, the dashboard and the command line; builds forge.jar.</description>

  <dependencies>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-pipeline</artifactId>
    </dependency>
    <!-- Transitive through forge-pipeline already. Listed because the coverage report only
         gathers modules named here directly; without them it covered two modules of eight. -->
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-security</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-review</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-deploy</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-marketing</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fmangoni</groupId>
      <artifactId>forge-report</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- One coverage report for the whole of Forge, where verify.bat says it is. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report-aggregate</goal></goals>
            <configuration>
              <includeCurrentProject>true</includeCurrentProject>
              <outputDirectory>${project.basedir}/../target/site/jacoco</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Fat jar so Task Scheduler can run: java -jar forge.jar run. Written to forge/target, where
        it was before the modules existed, so every script that starts Forge still finds it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.basedir}/../target/forge.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.fmangoni.forge.cli.Forge</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
